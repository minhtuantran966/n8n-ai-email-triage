    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "00000000-0000-4000-8000-000000000014",
              "name": "received_at",
              "value": "={{ DateTime.fromISO($json.date).setZone('Asia/Ho_Chi_Minh').toFormat('dd/MM/yyyy HH:mm') }}",
              "type": "string"
            },
            {
              "id": "00000000-0000-4000-8000-000000000015",
