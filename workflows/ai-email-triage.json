              "name": "content",
              "value": "={{ 'From: ' + $json.from.text + '\\nSubject: ' + $json.subject + '\\n\\n' + ($json.text || '').slice(0, 4000) }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        -752,
        208
      ],
      "name": "Prepare Email Content"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.content }}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You analyze emails sent to the sales inbox of a printing company in Ho Chi Minh City, Vietnam. Emails may be in Vietnamese or English. Only extract information that appears in the email. Never invent data. Use null for any field that is not mentioned. intent must be one of: quote_request (asking for a price or placing an order), complaint (complaint, return or exchange), question (general question), spam (advertising or unsolicited sales offers). urgency: high if the customer is upset or needs it urgently; medium if there is a deadline; low otherwise. budget_vnd: convert to a number in VND (e.g. 10 triệu = 10000000). phone: digits only, in the format 0xxxxxxxxx. summary: a one-sentence summary written in English. customer_name: only the customer's name; leave null for spam or automated emails."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        -528,
        208
      ],
      "name": "Analyze Email with AI",
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "options": {
          "temperature": 0
        }
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [
        -528,
        448
      ],
      "name": "Gemini Model",
      "credentials": {
        "googlePalmApi": {
          "id": "",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"intent\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"quote_request\",\n        \"complaint\",\n        \"question\",\n        \"spam\"\n      ]\n    },\n    \"customer_name\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"phone\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"product\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"quantity\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    },\n    \"budget_vnd\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    },\n    \"deadline\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"urgency\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"low\",\n        \"medium\",\n        \"high\"\n      ]\n    },\n    \"language\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"vi\",\n        \"en\",\n        \"other\"\n      ]\n    },\n    \"summary\": {\n      \"type\": \"string\",\n      \"description\": \"One-sentence summary in English\"\n    }\n  },\n  \"required\": [\n    \"intent\",\n    \"urgency\",\n    \"language\",\n    \"summary\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        -384,
        448
      ],
